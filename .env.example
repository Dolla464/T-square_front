# ============================================================================
# T-Square LMS Frontend — Environment Configuration Template
# ============================================================================
# خطوات الإعداد:
#   - للتطوير المحلي:   cp .env.example .env
#   - للإنتاج:          cp .env.example .env.production
#   ثم استبدل القيم بالبيانات الحقيقية.
#
# بعد الضبط شغّل:
#   npm run build          (يستخدم .env.production تلقائياً)
# ============================================================================

# ============================================================================
# API CONFIGURATION
# ============================================================================
# عنوان API الخلفي (Laravel Backend) — بدون trailing slash على /api
# للتطوير المحلي (مع Vite proxy — موصى به):
#   VITE_API_URL=http://localhost:5173/api
#   VITE_DEV_API_PROXY=http://t-square-lms.test
# بدون proxy (cross-origin):
#   VITE_API_URL=http://t-square-lms.test/api
# للإنتاج:
#   VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5173/api
VITE_DEV_API_PROXY=http://t-square-lms.test
